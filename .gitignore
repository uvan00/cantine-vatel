# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# données locales (formations, documents envoyés) : recréées au lancement
/donnees/

# données d'exécution (images envoyées) et captures de vérification
/donnees/
/captures/

# exemple de configuration, sans secret
!.env.example

# réglages locaux de Claude Code
.claude/settings.local.json
