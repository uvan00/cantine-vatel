// Tablée, la cantine sans file : comptes (Better Auth), menu jour par jour, réservations avec ticket, journal des
// mouvements d'argent, recharges, notes.
// SQLite : un fichier, rien à lancer ; passer à Postgres ne change que `provider` et `url`.
// SQLite ne connaît ni les listes ni les énumérations : les états sont des textes, les listes (allergènes, régimes) un
// texte séparé par des virgules (src/lib/listes.ts).
// Montants en francs CFA entiers. Jours en « AAAA-MM-JJ » : Abidjan est à l'heure GMT, aucun fuseau à gérer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Better Auth (e-mail et mot de passe) ─────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// convive | parent | admin. Posé par le serveur, jamais reçu du navigateur.
  role          String   @default("convive")
  /// false : un responsable de cantine désactivé par l'admin (parti, remplacé). Il ne se connecte plus ; ce qu'il a
  /// encaissé et servi reste à son nom.
  actif         Boolean  @default(true)

  sessions           Session[]
  accounts           Account[]
  profil             Profil?
  enfants            LienParent[]  @relation("parent")
  parents            LienParent[]  @relation("enfant")
  reservations       Reservation[]
  mouvements         Mouvement[]
  rechargesRecues    Recharge[]    @relation("beneficiaire")
  rechargesDemandees Recharge[]    @relation("demandeur")
  notes              Note[]
  favoris            Favori[]
  demandes           DemandeRepas[]
  lectures           MessageLu[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── La cantine ───────────────────────────────────────────────────────────────

/// Le profil d'un convive (élève ou employé) : ce qu'il ne mange pas, son code famille, son seuil d'alerte.
model Profil {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// eleve | employe
  genre       String @default("eleve")
  /// Classe ou service, en option.
  classe      String @default("")
  /// Identifiants d'allergènes séparés par des virgules (src/lib/listes.ts).
  allergenes  String @default("")
  /// Identifiants de régimes séparés par des virgules.
  regimes     String @default("")
  /// 6 caractères : le parent le saisit pour relier son enfant.
  codeFamille String @unique
  /// Sous ce solde, le convive et son parent sont prévenus.
  seuilAlerte Int    @default(2000)
  /// Plafond des repas d'une semaine (du lundi au dimanche), en francs ; vide : pas de plafond (src/lib/solde.ts).
  plafondSemaine Int?
  /// normal | reduit | personnel : prévu pour des tarifs réduits. Aucune règle ne l'applique encore : chaque repas
  /// est payé au prix du plat.
  tarif       String  @default("normal")
  /// La carte de cantine : 32 caractères au hasard, portés par son QR ; vide tant qu'elle n'a pas été montrée.
  carte       String? @unique
}

model LienParent {
  id       String   @id @default(cuid())
  parentId String
  enfantId String
  parent   User     @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  enfant   User     @relation("enfant", fields: [enfantId], references: [id], onDelete: Cascade)
  creeLe   DateTime @default(now())

  @@unique([parentId, enfantId])
}

model Plat {
  id          String     @id @default(cuid())
  nom         String
  description String     @default("")
  /// Adresse d'une image de public/plats (« /plats/attieke.jpg »), ou vide.
  photo       String     @default("")
  /// Prix proposé quand on l'ajoute à un jour.
  prix        Int
  allergenes  String     @default("")
  porc        Boolean    @default(false)
  vegetarien  Boolean    @default(false)
  creeLe      DateTime   @default(now())
  menus       MenuJour[]
  notes       Note[]
  favoris     Favori[]
  recette     LigneRecette[]
}

/// Un plat au menu d'un jour, avec son prix de ce jour-là.
model MenuJour {
  id           String        @id @default(cuid())
  jour         String
  platId       String
  plat         Plat          @relation(fields: [platId], references: [id])
  prix         Int
  /// Portions prévues ; vide : pas de limite.
  portions     Int?
  epuise       Boolean       @default(false)
  /// Les restes pesés après le service, en grammes ; vide tant que la cantine n'a rien pesé (src/lib/restes.ts).
  restes       Int?
  reservations Reservation[]
  demandes     DemandeRepas[]

  @@unique([jour, platId])
  @@index([jour])
}

model Reservation {
  id         String      @id @default(cuid())
  conviveId  String
  convive    User        @relation(fields: [conviveId], references: [id], onDelete: Cascade)
  menuJourId String
  menuJour   MenuJour    @relation(fields: [menuJourId], references: [id])
  jour       String
  /// Le prix payé, figé à la réservation.
  prix       Int
  /// reservee | servie | annulee. « Non retirée » se calcule : réservée alors que son jour est passé.
  etat       String      @default("reservee")
  /// express | reservation | classique : la file du comptoir, fixée à la création (src/lib/reservation.ts). Réservé et
  /// payé d'avance : express ; réservé, à payer au comptoir : reservation ; pris au comptoir avec le badge, sans
  /// réservation : classique. Les repas d'avant le 21/11/2026 sont tous « express ».
  file       String      @default("express")
  /// solde | a_payer | especes | mobile_money : comment le repas est payé. « a_payer » : rien n'est encaissé tant que la
  /// caisse ne l'a pas dit ; elle choisit alors le moyen, et le repas est servi dans le même geste.
  paiement   String      @default("solde")
  /// 32 caractères au hasard : c'est lui que porte le QR du ticket.
  jeton      String      @unique
  /// 6 caractères sans ambiguïté, à taper au comptoir si la caméra ne lit pas.
  code       String
  /// L'heure de passage choisie (« 12:15 ») quand la cantine a ouvert des créneaux ; vide sinon (src/lib/creneaux.ts).
  creneau    String?
  creeLe     DateTime    @default(now())
  serviLe    DateTime?
  /// Qui a servi : l'identifiant de la personne de la cantine qui a scanné, ou « borne ». Vide pour les repas servis
  /// avant le 21/11/2026.
  serviPar   String?
  annuleLe   DateTime?
  mouvements Mouvement[]
  note       Note?

  @@index([conviveId, jour])
  @@index([jour, code])
}

/// Le journal d'un compte : le solde est la somme des montants. Rien d'autre ne stocke le solde.
model Mouvement {
  id            String       @id @default(cuid())
  conviveId     String
  convive       User         @relation(fields: [conviveId], references: [id], onDelete: Cascade)
  /// recharge (plus) | repas (moins) | remboursement (plus)
  genre         String
  /// Signé, en francs CFA entiers.
  montant       Int
  libelle       String
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  rechargeId    String?
  recharge      Recharge?    @relation(fields: [rechargeId], references: [id])
  creeLe        DateTime     @default(now())

  @@index([conviveId, creeLe])
}

model Recharge {
  id             String      @id @default(cuid())
  beneficiaireId String
  beneficiaire   User        @relation("beneficiaire", fields: [beneficiaireId], references: [id], onDelete: Cascade)
  demandeurId    String
  demandeur      User        @relation("demandeur", fields: [demandeurId], references: [id], onDelete: Cascade)
  montant        Int
  /// « R-7K2M » : écrite dans le QR de paiement et dans le paiement Cartflox, lue par la cantine.
  reference      String      @unique
  /// cartflox (Mobile Money par Cartflox, confirmé tout seul) | pispi (QR universel, confirmé à la main) | especes
  moyen          String      @default("pispi")
  /// en_attente | confirmee | annulee
  etat           String      @default("en_attente")
  /// L'administrateur qui a touché « Paiement reçu », ou « cartflox » quand Cartflox a confirmé le paiement.
  confirmeePar   String?
  creeLe         DateTime    @default(now())
  confirmeeLe    DateTime?
  annuleeLe      DateTime?
  mouvements     Mouvement[]
  paiements      PaiementCartflox[]

  @@index([etat, creeLe])
}

/// Une session de paiement Cartflox ouverte pour une recharge. Une session ne sert qu'une seule recharge, pour toujours :
/// c'est ce qui empêche un même paiement de créditer deux fois.
model PaiementCartflox {
  /// L'identifiant de la session chez Cartflox.
  sessionId  String    @id
  rechargeId String
  recharge   Recharge  @relation(fields: [rechargeId], references: [id], onDelete: Cascade)
  /// Le dernier statut lu chez Cartflox : PENDING, SUCCESS, FAILED, CANCELLED, EXPIRED, REFUNDED.
  statut     String    @default("PENDING")
  /// Ce que Cartflox dit avoir encaissé à la dernière lecture (frais du payeur compris s'il y en a).
  montant    Int?
  devise     String?
  /// Pourquoi le paiement n'a pas abouti, ou pourquoi il n'a pas été crédité tout seul.
  remarque   String?
  creeLe     DateTime  @default(now())
  luLe       DateTime?

  @@index([rechargeId])
}

model Note {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  platId        String
  plat          Plat        @relation(fields: [platId], references: [id])
  conviveId     String
  convive       User        @relation(fields: [conviveId], references: [id], onDelete: Cascade)
  /// 1 à 5
  note          Int
  mot           String      @default("")
  creeLe        DateTime    @default(now())
}

// ── Ajouts du 21/11/2026 : réglages, créneaux, demandes hors délai, messages, favoris, recettes ─────────────────

/// Les réglages de la cantine : une seule ligne (id 1). Sans ligne, les valeurs par défaut s'appliquent (src/lib/reglages.ts).
model Reglages {
  id              Int     @id @default(1)
  /// Heure de clôture des réservations du jour (6 à 12) : la cuisine sait alors combien de repas préparer.
  heureCloture    Int     @default(9)
  /// Vrai : le convive choisit son heure de passage (src/lib/creneaux.ts).
  creneauxActifs  Boolean @default(false)
  creneauDebut    String  @default("11:45")
  creneauFin      String  @default("13:45")
  creneauMinutes  Int     @default(15)
  /// Passages au plus par créneau.
  creneauCapacite Int     @default(40)
  /// Les remises des tarifs, en pour cent du prix du plat : prévues, pas encore appliquées (aucun écran ne les règle).
  remiseReduit    Int     @default(50)
  remisePersonnel Int     @default(0)
}

/// Après la clôture, le convive demande un repas du jour ; la cantine l'accepte (une réservation à son nom) ou le refuse.
model DemandeRepas {
  id            String    @id @default(cuid())
  conviveId     String
  convive       User      @relation(fields: [conviveId], references: [id], onDelete: Cascade)
  menuJourId    String
  menuJour      MenuJour  @relation(fields: [menuJourId], references: [id], onDelete: Cascade)
  jour          String
  /// en_attente | acceptee | refusee
  etat          String    @default("en_attente")
  /// La réservation faite en acceptant.
  reservationId String?
  creeLe        DateTime  @default(now())
  traiteeLe     DateTime?

  @@index([jour, etat])
  @@index([conviveId, jour])
}

/// Un message de la cantine aux familles (src/lib/messages.ts).
model Message {
  id       String      @id @default(cuid())
  titre    String
  texte    String
  /// tous | convives | parents | semaine (ceux qui ont réservé cette semaine, et leurs parents)
  cible    String      @default("tous")
  epingle  Boolean     @default(false)
  auteurId String
  creeLe   DateTime    @default(now())
  lectures MessageLu[]

  @@index([creeLe])
}

model MessageLu {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  luLe      DateTime @default(now())

  @@id([messageId, userId])
}

/// Un plat que le convive aime : une étoile sur sa carte, et une alerte quand il revient au menu.
model Favori {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platId String
  plat   Plat     @relation(fields: [platId], references: [id], onDelete: Cascade)
  creeLe DateTime @default(now())

  @@id([userId, platId])
}

/// Un ingrédient de la cuisine, avec l'unité dans laquelle on le compte (src/lib/besoins.ts).
model Ingredient {
  id     String         @id @default(cuid())
  nom    String         @unique
  /// g | ml | piece : en grammes, en millilitres ou à la pièce
  unite      String           @default("g")
  lignes     LigneRecette[]
  /// Ce qui entre dans la réserve et en sort (lot 2 des besoins, 21/11/2026).
  mouvements MouvementStock[]
}

/// Une ligne de la fiche recette d'un plat : la quantité d'un ingrédient pour une portion.
model LigneRecette {
  platId       String
  plat         Plat       @relation(fields: [platId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// Pour une portion, dans l'unité de l'ingrédient, en entier.
  quantite     Int

  @@id([platId, ingredientId])
}

/// Une dépense de la cantine (comptabilité, demande du propriétaire du 21/11/2026) : la cantine la note à la main, et
/// elle entre dans le bilan (src/lib/comptabilite.ts). Elle ne touche aucun solde d'élève.
model Depense {
  id          String   @id @default(cuid())
  /// « 2026-11-21 » : le jour où la cantine a payé.
  jour        String
  /// ingredients | gaz | emballages | salaires | autres
  categorie   String
  libelle     String
  /// En francs CFA entiers, toujours positif.
  montant     Int
  /// À qui la cantine a payé ; vide si elle ne le précise pas.
  fournisseur String   @default("")
  /// especes | mobile_money | virement | autre
  moyen       String   @default("especes")
  /// Le nom de l'administrateur qui l'a notée.
  noteePar    String
  creeLe      DateTime @default(now())

  @@index([jour])
}

/// Ce qui entre dans la réserve de la cuisine et en sort, ingrédient par ingrédient (lot 2 des besoins, 21/11/2026).
/// Le stock d'un ingrédient est la somme de ses mouvements, dans son unité (src/lib/stock.ts).
model MouvementStock {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// livraison | sortie | inventaire
  genre        String
  /// Signée, dans l'unité de l'ingrédient : + une livraison, - une sortie, l'écart compté à l'inventaire.
  quantite     Int
  /// Le jour servi, pour une sortie ; le jour de la livraison ou du comptage sinon.
  jour         String
  /// Ce que la livraison a coûté, en F CFA entiers ; null sinon.
  prix         Int?
  /// L'id de la Depense notée en même temps (catégorie « ingredients »), pour une livraison payée.
  depenseId    String?
  note         String     @default("")
  /// Le nom de l'administrateur qui l'a noté.
  noteePar     String
  creeLe       DateTime   @default(now())

  @@index([ingredientId])
  @@index([jour])
}
