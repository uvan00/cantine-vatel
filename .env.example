# Base de données locale (fichier SQLite, recréé par `npm run demo`)
DATABASE_URL="file:../donnees/cantine.db"

# Connexion (Better Auth) : une longue valeur au hasard, par exemple `openssl rand -hex 32`. Jamais dans git.
BETTER_AUTH_SECRET=""
# Adresse publique de l'application (en local : http://localhost:3700)
BETTER_AUTH_URL="http://localhost:3700"

# Recharge : l'adresse de paiement PI-SPI de la cantine (36 caractères, lue dans l'application de son compte).
# Vide : l'écran de recharge le dit et ne montre que la référence.
PISPI_ALIAS=""

# Paiement en ligne par Cartflox (Mobile Money de Côte d'Ivoire). Les deux clés du même mode, posées par
# ./scripts/cle-cartflox.sh dans .env.local (jamais ici, jamais dans git). Sans elles, la recharge se règle en espèces au
# comptoir (le QR universel est coupé pour le moment, src/lib/recharge.ts).
# CARTFLOX_CLE_PUBLIQUE=""
# CARTFLOX_CLE_SECRETE=""
# Adresse de Cartflox (par défaut https://cartflox.com)
# CARTFLOX_API="https://cartflox.com"

# La suggestion de la semaine par l'IA (bonus 5) : la clé d'Anthropic de la cantine, posée par ./scripts/cle-ia.sh dans
# .env.local (jamais ici, jamais dans git). Sans elle, le rapport de la semaine le dit et rien ne part vers l'IA.
# ANTHROPIC_API_KEY=

# « Essayer sans compte » sur la page de connexion (comptes de démonstration de `npm run demo`). À laisser coupé avec de
# vraies données. Le compte de la cantine ne s'ouvre en un clic que sur un ordinateur de développement.
# MODE_DEMO="1"

# Adresses en plus de BETTER_AUTH_URL d'où l'on peut se connecter, séparées par des virgules (le wifi, en essai).
# ORIGINES_DE_CONFIANCE="http://192.168.1.10:3700"

# L'aperçu web de l'application mobile : les origines de navigateur qui ont le droit d'appeler
# /api/mobile, séparées par des virgules. Un téléphone n'en a pas besoin. Sans elle, aucun navigateur n'y a droit.
# MOBILE_ORIGINES_WEB="http://localhost:8081"
