# Base de données locale (fichier SQLite, recréé par `npm run demo`)
DATABASE_URL="file:../donnees/cantine.db"

# Connexion (Better Auth) : une longue valeur au hasard, par exemple `openssl rand -hex 32`. Jamais dans git.
BETTER_AUTH_SECRET=""
# Adresse publique de l'application (en local : http://localhost:3700)
BETTER_AUTH_URL="http://localhost:3700"

# Recharge : l'adresse de paiement PI-SPI de la cantine (36 caractères, lue dans l'application de son compte).
# Vide : l'écran de recharge le dit et ne montre que la référence.
PISPI_ALIAS=""

# Paiement en ligne par Cartflox (Mobile Money de Côte d'Ivoire). Les deux clés du même mode, posées par
# ./scripts/cle-cartflox.sh dans .env.local (jamais ici, jamais dans git). Sans elles, seul le QR universel est proposé.
# CARTFLOX_CLE_PUBLIQUE=""
# CARTFLOX_CLE_SECRETE=""
# Adresse de Cartflox (par défaut https://cartflox.com)
# CARTFLOX_API="https://cartflox.com"
